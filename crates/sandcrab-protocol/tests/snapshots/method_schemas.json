          "type": "string"
        },
        "features": {
          "default": [],
          "description": "What this daemon can do beyond the tools (see [`crate::features`]). Empty from a `crabd` before 0.3.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forward_ports": {
          "default": [],
          "description": "Loopback ports this daemon forwards (`--forward-port`). Empty from a `crabd` before 0.3.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "protocol_version": {
          "description": "Protocol version spoken by `crabd` (see [`crate::PROTOCOL_VERSION`]).",
          "type": "string"
        },
        "tools": {
          "description": "Tool methods this daemon implements.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
