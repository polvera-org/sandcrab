  {
    "method": "forward.stats",
    "kind": "call",
    "params": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "result": {
      "items": {
        "description": "Counters of one forward port.",
        "properties": {
          "accepted": {
            "description": "Connections handed to the host by `forward.accept`.",
            "minimum": 0,
            "type": "integer"
          },
          "port": {
            "minimum": 0,
            "type": "integer"
          },
          "refused": {
            "description": "Why connections to a forward port were closed, counted since start.",
            "properties": {
              "cap": {
                "description": "Over a connection cap.",
                "minimum": 0,
                "type": "integer"
              },
              "no_listener": {
                "description": "No `forward.listen` connection.",
                "minimum": 0,
                "type": "integer"
              },
              "rejected": {
                "description": "`forward.reject` from the host.",
                "minimum": 0,
                "type": "integer"
              },
              "unclaimed": {
                "description": "Announced but not accepted within 10 s.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cap",
              "no_listener",
              "rejected",
              "unclaimed"
            ],
            "type": "object"
          }
        },
        "required": [
          "accepted",
          "port",
          "refused"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
