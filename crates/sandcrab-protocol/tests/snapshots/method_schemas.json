  {
    "method": "record:EXIT",
    "kind": "record",
    "params": {
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "code": {
          "description": "Exit code, or `None` when a signal ended the leader.",
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "overflow": {
          "description": "stdout went over `output_cap.max_bytes`.",
          "type": "boolean"
        },
        "signal": {
          "description": "Signal that ended the leader.",
          "type": [
            "integer",
            "null"
          ]
        },
        "stderr_tail": {
          "description": "Last bytes of stderr, lossy UTF-8, cut at a character boundary. Empty with `merge`.",
          "type": "string"
        },
        "timed_out": {
          "type": "boolean"
        },
        "tree_clean": {
          "description": "False: something of the tree could not be stopped. The caller should destroy the sandbox.",
          "type": "boolean"
        }
      },
      "required": [
        "cancelled",
        "duration_ms",
        "overflow",
        "stderr_tail",
        "timed_out",
        "tree_clean"
      ],
      "type": "object"
    },
    "result": null
  }
