  {
    "method": "process.open",
    "kind": "connection",
    "params": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "description": "`argv[0]` is the program. Not empty. No element contains NUL.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "description": "Absolute. Default: the sandbox's default cwd.",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "The exact environment. Nothing is added, nothing inherited.",
          "type": "object"
        },
        "kill_grace_ms": {
          "description": "Grace between ask and force at the bound, at the cap and on a closed connection. Default 500.",
          "minimum": 0,
          "type": "integer"
        },
        "limits": {
          "additionalProperties": false,
          "description": "Resource limits applied to the program before it starts. Each `None` inherits the sandbox's limit. A value above the sandbox's own hard limit is `-32602`, never clamped.",
          "properties": {
            "data_bytes": {
              "description": "`RLIMIT_DATA`, at least 32 MiB.",
              "minimum": 0,
              "type": "integer"
            },
            "fsize_bytes": {
              "description": "`RLIMIT_FSIZE`.",
              "minimum": 0,
              "type": "integer"
            },
            "nofile": {
              "description": "`RLIMIT_NOFILE`, at least 64.",
              "minimum": 0,
              "type": "integer"
            },
            "nproc": {
              "description": "`RLIMIT_NPROC`. On Docker it counts every process of the uid on the host.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "oom_score_adj": {
          "description": "0..=1000. Only raises the score. Default: unchanged.",
          "minimum": 0,
          "type": "integer"
        },
        "output_cap": {
          "additionalProperties": false,
          "description": "A bound on stdout (and stderr with [`StderrMode::Merge`]).",
          "properties": {
            "max_bytes": {
              "description": "At least 1. At most 8 MiB with `tail`.",
              "minimum": 0,
              "type": "integer"
            },
            "on_overflow": {
              "description": "What happens when stdout passes [`OutputCap::max_bytes`].",
              "oneOf": [
                {
                  "description": "Stream as usual; cut the record at the cap and stop the tree.",
                  "enum": [
                    "kill"
                  ],
                  "type": "string"
                },
                {
                  "description": "Do not stream; keep the last `max_bytes` and send them when the program has ended.",
                  "enum": [
                    "tail"
                  ],
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "max_bytes",
            "on_overflow"
          ],
          "type": "object"
        },
        "process_id": {
          "description": "Chosen by the caller: a UUID. Lets a cancel arrive before the ack.",
          "type": "string"
        },
        "stderr": {
          "default": "tail",
          "description": "What happens to the program's stderr.",
          "oneOf": [
            {
              "description": "Not streamed; the last `stderr_tail_bytes` are in [`ProcessExit::stderr_tail`].",
              "enum": [
                "tail"
              ],
              "type": "string"
            },
            {
              "description": "Sent with stdout, on one pipe, as `STDOUT` records. The tail is empty.",
              "enum": [
                "merge"
              ],
              "type": "string"
            },
            {
              "description": "Streamed as `STDERR` records; the tail is kept too.",
              "enum": [
                "stream"
              ],
              "type": "string"
            }
          ]
        },
        "stderr_tail_bytes": {
          "description": "Bytes of stderr kept for the exit with `tail` and `stream`. Default 4096, max 65536.",
          "minimum": 0,
          "type": "integer"
        },
        "stdin": {
          "default": "null",
          "description": "What the program's stdin is.",
          "oneOf": [
            {
              "description": "`/dev/null`.",
              "enum": [
                "null"
              ],
              "type": "string"
            },
            {
              "description": "A pipe fed by `STDIN` records and closed by `STDIN_EOF`.",
              "enum": [
                "pipe"
              ],
              "type": "string"
            }
          ]
        },
        "timeout_ms": {
          "description": "Wall-clock bound, timed in the guest. None: no bound.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "process_id"
      ],
      "type": "object"
    },
    "result": {
      "properties": {
        "pid": {
          "description": "Guest pid of the program (the leader of its tree).",
          "minimum": 0,
          "type": "integer"
        },
        "process_id": {
          "type": "string"
        }
      },
      "required": [
        "pid",
        "process_id"
      ],
      "type": "object"
    }
  },
