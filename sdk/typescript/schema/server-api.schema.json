        }
      },
      "required": [
        "detail",
        "evidence",
        "id",
        "required",
        "status"
      ],
      "type": "object"
    },
    "SelftestParams": {
      "additionalProperties": false,
      "description": "`server.selftest` params.",
      "properties": {
        "max_age_secs": {
          "description": "Return the last report for this template when it is younger than this. Default: always run a fresh one.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "type": "object"
    },
    "SelftestReport": {
      "description": "`server.selftest` result: a report for one template (design §8).",
      "properties": {
        "backend": {
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/SelftestLine"
          },
          "type": "array"
        },
        "ok": {
          "description": "True only when every required line is `pass`.",
          "type": "boolean"
        },
        "reason": {
          "description": "One sentence naming the first line that did not pass; `null` when `ok`.",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "RFC 3339.",
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "backend",
        "duration_ms",
        "lines",
        "ok",
        "started_at",
        "template"
      ],
      "type": "object"
    },
    "SelftestStatus": {
      "description": "How one self-test line ended. A timeout is never a pass.",
      "oneOf": [
        {
          "enum": [
            "pass",
            "fail"
          ],
          "type": "string"
        },
        {
          "description": "The probe hit its deadline, hung or never started.",
          "enum": [
            "inconclusive"
          ],
          "type": "string"
        }
      ]
    },
    "SelftestSummary": {
      "description": "The last self-test of one template, in short.",
      "properties": {
        "age_secs": {
          "description": "Age of the report.",
          "minimum": 0,
          "type": "integer"
        },
        "ok": {
          "description": "True only when every required line passed.",
          "type": "boolean"
        },
        "reason": {
          "description": "One sentence naming the first line that did not pass; `null` when `ok`.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "age_secs",
        "ok",
        "template"
      ],
      "type": "object"
    },
    "ServerHelloParams": {
      "additionalProperties": false,
