      "description": "The server's limits (design §5.6). Over a limit is `LIMIT_EXCEEDED`; nothing queues.",
      "properties": {
        "default_ttl_secs": {
          "description": "TTL of a sandbox created without `ttl_secs`.",
          "minimum": 0,
          "type": "integer"
        },
        "max_connections": {
          "description": "Connections of all kinds.",
          "minimum": 0,
          "type": "integer"
        },
        "max_memory_mb": {
          "minimum": 0,
          "type": "integer"
        },
        "max_mounts": {
          "minimum": 0,
          "type": "integer"
        },
        "max_nofile": {
          "minimum": 0,
          "type": "integer"
        },
        "max_pids": {
          "minimum": 0,
          "type": "integer"
        },
        "max_processes_per_sandbox": {
          "minimum": 0,
          "type": "integer"
        },
        "max_requests_in_flight": {
          "description": "Requests in flight per control connection; beyond that the server stops reading.",
          "minimum": 0,
          "type": "integer"
        },
        "max_sandboxes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_ttl_secs": {
          "minimum": 0,
          "type": "integer"
        },
        "max_vcpu": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "default_ttl_secs",
        "max_connections",
        "max_memory_mb",
        "max_mounts",
        "max_nofile",
        "max_pids",
        "max_processes_per_sandbox",
        "max_requests_in_flight",
        "max_sandboxes",
        "max_ttl_secs",
        "max_vcpu"
      ],
      "type": "object"
    },
    "ServerShutdown": {
      "description": "`server.shutdown` notification: the server stops; every sandbox will be destroyed.",
      "properties": {
        "grace_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "grace_ms"
      ],
      "type": "object"
    },
    "StderrMode": {
      "description": "What happens to the program's stderr.",
      "oneOf": [
        {
          "description": "Not streamed; the last `stderr_tail_bytes` are in [`ProcessExit::stderr_tail`].",
          "enum": [
            "tail"
          ],
          "type": "string"
        },
        {
          "description": "Sent with stdout, on one pipe, as `STDOUT` records. The tail is empty.",
          "enum": [
            "merge"
          ],
          "type": "string"
        },
        {
          "description": "Streamed as `STDERR` records; the tail is kept too.",
          "enum": [
            "stream"
          ],
          "type": "string"
        }
      ]
    },
    "StdinMode": {
      "description": "What the program's stdin is.",
      "oneOf": [
        {
          "description": "`/dev/null`.",
          "enum": [
            "null"
          ],
          "type": "string"
        },
        {
          "description": "A pipe fed by `STDIN` records and closed by `STDIN_EOF`.",
          "enum": [
            "pipe"
          ],
          "type": "string"
        }
      ]
    },
    "TemplateErrorData": {
      "description": "`data` of `TEMPLATE_ERROR`.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TemplateErrorKind"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
