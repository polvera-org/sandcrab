        "client": {
          "description": "The client's, as it sent it.",
          "type": "string"
        },
        "server": {
          "description": "The server's API version.",
          "type": "string"
        }
      },
      "required": [
        "client",
        "server"
      ],
      "type": "object"
    }
  },
